# ==========================================
# OPTION A: AWS S3 Credentials (Recommended if using AWS)
# ==========================================
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=ap-south-1
AWS_BUCKET_NAME=your_s3_bucket_name

# Optional AWS endpoint (for custom S3 endpoints or MinIO)
# AWS_ENDPOINT=https://s3.ap-south-1.amazonaws.com

# ==========================================
# OPTION B: Cloudflare R2 Credentials (Alternative)
# ==========================================
# R2_ACCOUNT_ID=your_cloudflare_account_id
# R2_ACCESS_KEY_ID=your_r2_access_key_id
# R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
# R2_BUCKET_NAME=your_r2_bucket_name

# ==========================================
# Authentication Session Secret (Required)
# ==========================================
SESSION_SECRET=your_random_session_secret_key_at_least_32_characters
