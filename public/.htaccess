# Hostinger Apache .htaccess Configuration for React SPA + PHP API

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Enforce HTTPS (Recommended for Hostinger SSL)
  # RewriteCond %{HTTPS} off
  # RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Route /sitemap.xml dynamically to /api/sitemap.php
  RewriteRule ^sitemap\.xml$ /api/sitemap.php [L]

  # Do NOT rewrite if request is for existing files or directories
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Direct API and Upload requests to their respective files
  RewriteCond %{REQUEST_URI} ^/(api|uploads)/ [NC]
  RewriteRule ^ - [L]

  # Fallback all SPA routes (e.g. /gallery, /gallery/upload) to index.html
  RewriteRule ^ index.html [L]
</IfModule>

# Browser Caching & Gzip Compression Configuration
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json application/xml
</IfModule>

<IfModule mod_headers.c>
  # Prevent MIME-type sniffing security header
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set X-XSS-Protection "1; mode=block"
</IfModule>
